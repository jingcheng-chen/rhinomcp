{
  "id": "inspect_document-v1",
  "type": "workflow_scene",
  "family": "document-inspection",
  "instruction": "Inspect the prepared document without making any changes. Find sample_a and sample_b on Samples. Return one inspection entry for each, containing its name, measured volume in cubic millimeters, and world min/max bounds in millimeters. Do not infer dimensions from names; use read-only tools. Preserve all objects, IDs, geometry, attributes and layers. Match bounds within 0.001 mm and volume within 1%; objects must be visible and unlocked.",
  "units": "Millimeters",
  "linear_tolerance": 0.001,
  "relative_volume_tolerance": 0.01,
  "initial": [
    {
      "name": "sample_a",
      "layer": "Samples",
      "min": [
        10,
        20,
        0
      ],
      "max": [
        40,
        40,
        10
      ]
    },
    {
      "name": "sample_b",
      "layer": "Samples",
      "min": [
        -30,
        -10,
        0
      ],
      "max": [
        -10,
        5,
        12
      ]
    }
  ],
  "targets": [
    {
      "name": "sample_a",
      "layer": "Samples",
      "min": [
        10,
        20,
        0
      ],
      "max": [
        40,
        40,
        10
      ],
      "preserve_from": "sample_a",
      "unchanged": true
    },
    {
      "name": "sample_b",
      "layer": "Samples",
      "min": [
        -30,
        -10,
        0
      ],
      "max": [
        -10,
        5,
        12
      ],
      "preserve_from": "sample_b",
      "unchanged": true
    }
  ],
  "layers": [
    "Samples"
  ],
  "inspection_names": [
    "sample_a",
    "sample_b"
  ]
}
