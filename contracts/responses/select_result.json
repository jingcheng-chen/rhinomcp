{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "select_result.json",
  "title": "SelectResult Response",
  "description": "Result of a select operation",
  "type": "object",
  "properties": {
    "count": {
      "type": "integer",
      "description": "Number of objects selected",
      "minimum": 0
    },
    "matched": {
      "type": "integer",
      "description": "Number of objects the filters matched (select_objects, plugin 0.5.0+). Larger than count when matched objects are hidden or locked, which Rhino cannot select.",
      "minimum": 0
    }
  },
  "required": ["count"]
}
